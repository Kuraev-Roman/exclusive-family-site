<%- include('partials/header') %>

<div class="wrap">
  <div class="eyebrow">⚙️ Админ</div>
  <h1 class="gradient-text" style="font-size:2rem;">Альбом — загрузка</h1>
  <p style="color:var(--muted); margin-bottom:24px;">Можно выбрать сразу несколько фото и видео (до ~60MB на файл).</p>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <div class="card" style="margin-bottom:30px;">
    <form class="stack" method="POST" action="/admin/album/upload" enctype="multipart/form-data" style="max-width:560px;">
      <div class="field">
        <label>Фото / видео</label>
        <input type="file" name="files" accept="image/*,video/*" multiple required>
      </div>
      <div class="field">
        <label>Подпись (необязательно, для всех выбранных файлов)</label>
        <input type="text" name="caption" placeholder="Например: встреча семьи, август 2026">
      </div>
      <button class="btn btn-fun" type="submit">📸 Загрузить</button>
    </form>
  </div>

  <h2 style="font-size:1.2rem; margin-bottom:16px;">Все файлы (<%= items.length %>)</h2>
  <% if (items.length === 0) { %>
    <div class="card empty-state"><span class="big-emoji">📸</span>Пока ничего не загружено.</div>
  <% } else { %>
    <div class="album-grid">
      <% items.forEach(function(it) { %>
        <div class="album-item">
          <% if (it.type === 'video') { %>
            <video src="<%= it.path %>" controls preload="metadata"></video>
            <span class="video-badge">🎬</span>
          <% } else { %>
            <img src="<%= it.path %>" alt="фото">
          <% } %>
          <form action="/admin/album/<%= it.id %>/delete" method="POST" onsubmit="return confirm('Удалить файл?');"
                style="position:absolute; top:8px; left:8px; z-index:2;">
            <button class="btn btn-sm btn-danger" type="submit">✕</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
