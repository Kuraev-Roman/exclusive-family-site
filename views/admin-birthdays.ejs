<%- include('partials/header') %>

<div class="wrap">
  <div class="eyebrow">⚙️ Админ</div>
  <h1 class="gradient-text" style="font-size:2rem;">Дни рождения — управление</h1>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <div class="grid grid-2">
    <div class="card">
      <h2 style="font-size:1.1rem;">Добавить вручную</h2>
      <form class="stack" method="POST" action="/admin/birthdays/add" enctype="multipart/form-data">
        <div class="field"><label>Ник</label><input type="text" name="nickname" required></div>
        <div class="field"><label>День (1-31)</label><input type="number" name="day" min="1" max="31" required></div>
        <div class="field"><label>Месяц (1-12)</label><input type="number" name="month" min="1" max="12" required></div>
        <div class="field"><label>Фото (необязательно)</label><input type="file" name="photo" accept="image/*"></div>
        <button class="btn btn-solid" type="submit">Добавить</button>
      </form>
    </div>

    <div class="card">
      <h2 style="font-size:1.1rem;">Импорт таблицы</h2>
      <p style="color:var(--muted); font-size:.85rem;">Загрузите .xlsx или .csv с колонками «Ник» и «День рождения» (или отдельно «День»/«Месяц»).</p>
      <form class="stack" method="POST" action="/admin/birthdays/import" enctype="multipart/form-data">
        <div class="field"><label>Файл (.xlsx / .csv)</label><input type="file" name="file" accept=".xlsx,.xls,.csv" required></div>
        <button class="btn btn-solid" type="submit">Импортировать</button>
      </form>
    </div>
  </div>

  <div class="card" style="margin-top:24px;">
    <h2 style="font-size:1.1rem;">Все записи (<%= rows.length %>)</h2>
    <table class="bday-table">
      <thead><tr><th>Фото</th><th>Ник</th><th>День</th><th>Месяц</th><th></th></tr></thead>
      <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td>
            <% if (r.photo) { %>
              <img src="<%= r.photo %>" class="mini-avatar">
            <% } else { %>
              <span style="color:var(--muted); font-size:.75rem;">нет фото</span>
            <% } %>
          </td>
          <td><%= r.nickname %></td>
          <td><%= r.day %></td>
          <td><%= r.month %></td>
          <td>
            <div class="row-actions">
              <form action="/admin/birthdays/<%= r.id %>/photo" method="POST" enctype="multipart/form-data" class="inline-form" style="display:flex; gap:6px;">
                <input type="file" name="photo" accept="image/*" style="width:130px; font-size:.7rem;">
                <button class="btn btn-sm" type="submit">Фото</button>
              </form>
              <form action="/admin/birthdays/<%= r.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Удалить запись?');">
                <button class="btn btn-sm btn-danger" type="submit">Удалить</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
