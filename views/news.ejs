<%- include('partials/header') %>

<div class="wrap" style="max-width:720px;">
  <div class="eyebrow">Лента</div>
  <h1 class="gradient-text" style="font-size:2.1rem;">📰 Новости семьи</h1>
  <p style="color:var(--muted); margin-bottom:30px;">Сюда админ переносит посты из телеграм-канала: текст, фото и видео.</p>

  <% if (items.length === 0) { %>
    <div class="card empty-state">Пока нет ни одного поста.</div>
  <% } %>

  <% items.forEach(function(n) { %>
    <div class="card news-post">
      <div class="meta"><%= new Date(n.createdAt).toLocaleString('ru-RU') %></div>
      <% if (n.text) { %><div class="text"><%= n.text %></div><% } %>
      <% if (n.images && n.images.length) { %>
        <div class="news-images">
          <% n.images.forEach(function(img) { %><img src="<%= img %>" alt="фото новости"><% }) %>
        </div>
      <% } %>
      <% if (n.videoUrl) { %>
        <div class="video-slot">
          🎬 Видео: <a href="<%= n.videoUrl %>" target="_blank" rel="noopener" style="margin-left:6px;"><%= n.videoUrl %></a>
        </div>
      <% } %>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
