<%- include('partials/header') %>

<div class="wrap" style="max-width:760px;">
  <div class="eyebrow">❓ Раздел</div>
  <h1 class="gradient-text" style="font-size:2.1rem;">Частые вопросы</h1>
  <p style="color:var(--muted); margin-bottom:30px;">Если не нашёл ответ здесь — загляни в <a href="/guide">гайд для новичков</a> или напиши напрямую в <a href="/contacts">администрацию</a>.</p>

  <% if (items.length === 0) { %>
    <div class="card empty-state"><span class="big-emoji">❓</span>Вопросов пока не добавлено.</div>
  <% } %>

  <% items.forEach(function(f) { %>
    <details class="faq-item">
      <summary><%= f.question %></summary>
      <p><%= f.answer %></p>
    </details>
  <% }) %>
</div>

<%- include('partials/footer') %>
