<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' + settings.siteName : settings.siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/logo.jpg">
</head>
<body>
  <canvas id="bg-particles"></canvas>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <img src="/images/logo-crest.jpg" alt="<%= settings.siteName %>">
        <div class="brand-text">
          <div class="name">EXCLUSIVE</div>
          <div class="tag"><%= settings.tagline %></div>
        </div>
      </a>

      <button class="burger-btn" id="burgerBtn" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="mainNav">
        <a href="/">🏠 Главная</a>

        <div class="nav-item has-dropdown">
          <button type="button" class="nav-toggle">🏰 О семье <span class="caret">▾</span></button>
          <div class="nav-dropdown">
            <a href="/news">📰 Новости</a>
            <a href="/album">📸 Альбом</a>
            <a href="/birthdays">🎂 Дни рождения</a>
            <a href="/interactives">🗳️ Интерактивы</a>
          </div>
        </div>

        <div class="nav-item has-dropdown">
          <button type="button" class="nav-toggle">🤝 Сообщество <span class="caret">▾</span></button>
          <div class="nav-dropdown">
            <a href="/join">✨ Вступить</a>
            <a href="/guide">🧭 Навигация для новичков</a>
            <a href="/faq">❓ FAQ</a>
            <a href="/team">📮 Связь с администрацией</a>
          </div>
        </div>

        <% if (currentUser) { %>
          <a href="/kraj/send">🚨 Кражи</a>
        <% } %>

        <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'deputy')) { %>
          <div class="nav-item has-dropdown">
            <button type="button" class="nav-toggle">⚙️ Админ-панель <span class="caret">▾</span></button>
            <div class="nav-dropdown">
              <a href="/admin">📊 Обзор панели</a>
              <% if (currentUser.role === 'admin') { %>
                <a href="/admin/users">👤 Аккаунты</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('birthdays')) { %>
                <a href="/admin/birthdays">🎂 Дни рождения</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('news')) { %>
                <a href="/admin/news">📰 Новости</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('album')) { %>
                <a href="/admin/album">📸 Альбом</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('interactives')) { %>
                <a href="/admin/interactives">🗳️ Интерактивы</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('applications')) { %>
                <a href="/admin/applications">✨ Заявки</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('faq')) { %>
                <a href="/admin/faq">❓ FAQ</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('questions')) { %>
                <a href="/admin/questions">📮 Обращения</a>
              <% } %>
              <% if (currentUser.role === 'admin' || currentUser.portals.includes('kraj')) { %>
                <a href="/kraj">🚨 Кражи (список)</a>
              <% } %>
              <% if (currentUser.role === 'admin') { %>
                <a href="/admin/settings">🔗 Настройки</a>
              <% } %>
            </div>
          </div>
        <% } %>

        <div class="nav-actions-mobile">
          <% if (currentUser) { %>
            <a href="/profile" class="btn btn-sm">👤 <%= currentUser.nickname %></a>
            <form action="/logout" method="POST" class="inline-form" style="width:100%;">
              <button class="btn btn-sm btn-danger" type="submit" style="width:100%;">Выйти</button>
            </form>
          <% } else { %>
            <a href="/login" class="btn btn-solid btn-sm">Войти</a>
          <% } %>
        </div>
      </nav>

      <div class="header-actions">
        <% if (currentUser) { %>
          <a href="/profile" class="btn btn-sm">👤 <%= currentUser.nickname %></a>
          <form action="/logout" method="POST" class="inline-form">
            <button class="btn btn-sm btn-danger" type="submit">Выйти</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn-solid btn-sm">Войти</a>
        <% } %>
      </div>
    </div>
  </header>
  <div class="nav-overlay" id="navOverlay"></div>
  <main>
