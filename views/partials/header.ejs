<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' + settings.siteName : settings.siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/logo.jpg">
</head>
<body>
  <canvas id="bg-particles"></canvas>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <img src="/images/logo.jpg" alt="<%= settings.siteName %>">
        <div class="brand-text">
          <div class="name">EXCLUSIVE</div>
          <div class="tag"><%= settings.tagline %></div>
        </div>
      </a>

      <nav class="main-nav">
        <a href="/">Главная</a>
        <a href="/birthdays">🎂 Дни рождения</a>
        <a href="/news">📰 Новости</a>
        <a href="/interactives">🗳️ Интерактивы</a>
        <a href="/minions">🍌 Миньоны</a>
        <% if (currentUser) { %>
          <a href="/kraj/send">🚨 Кражи</a>
        <% } %>
        <% if (!currentUser) { %>
          <a href="/join" class="highlight">✨ Вступить</a>
        <% } %>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/admin">⚙️ Админ-панель</a>
        <% } %>
      </nav>

      <div class="header-actions">
        <% if (currentUser) { %>
          <a href="/profile" class="btn btn-sm">👤 <%= currentUser.nickname %></a>
          <form action="/logout" method="POST" class="inline-form">
            <button class="btn btn-sm btn-danger" type="submit">Выйти</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn-solid btn-sm">Войти</a>
        <% } %>
      </div>
    </div>
  </header>
  <main>
