<%- include('partials/header') %>

<div class="wrap">
  <div class="eyebrow">📇 Раздел</div>
  <h1 class="gradient-text" style="font-size:2.1rem;">Администрация семьи</h1>
  <p style="color:var(--muted); margin-bottom:30px;">Если есть личный вопрос — напиши напрямую тому, кто может помочь.</p>

  <% if (staff.length === 0) { %>
    <div class="card empty-state"><span class="big-emoji">📇</span>Список пока пуст — админ ещё не заполнил контакты.</div>
  <% } %>

  <div class="grid grid-3">
    <% staff.forEach(function(s) { %>
      <div class="card" style="text-align:center;">
        <div class="avatar-lg-placeholder" style="margin:0 auto 14px;"><%= s.nickname.charAt(0).toUpperCase() %></div>
        <span class="badge <%= s.role === 'admin' ? 'badge-admin' : 'badge-member' %>"><%= s.title %></span>
        <h3 style="font-size:1.1rem; margin:10px 0 4px;"><%= s.nickname %></h3>
        <% if (s.contactUrl) { %>
          <a href="<%= s.contactUrl %>" target="_blank" rel="noopener" class="btn btn-sm btn-solid" style="margin-top:8px;">✉️ Написать</a>
        <% } else { %>
          <p style="color:var(--muted); font-size:.8rem; margin-top:8px;">Контакт не указан</p>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
