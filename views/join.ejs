<%- include('partials/header') %>

<div class="wrap" style="max-width:640px;">
  <div class="eyebrow">✨ Вступление</div>
  <h1 class="gradient-text" style="font-size:2.1rem;">Хочешь в семью EXCLUSIVE?</h1>
  <p style="color:var(--muted); margin-bottom:24px;"><%= joinIntro %></p>

  <% if (joinCriteria.length) { %>
    <div class="card" style="margin-bottom:26px;">
      <h2 style="font-size:1.1rem;">📋 Условия и критерии вступления</h2>
      <ul class="criteria-list" style="margin-top:14px;">
        <% joinCriteria.forEach(function(c) { %>
          <li><span class="icon"><%= c.icon %></span> <%- c.text %></li>
        <% }) %>
      </ul>
      <p style="color:var(--muted); font-size:.82rem; margin-top:14px;">Условия могут уточняться админом индивидуально — это ориентир, а не жёсткий фильтр.</p>
    </div>
  <% } %>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success">🎉 <%= success %></div><% } %>

  <div class="card">
    <h2 style="font-size:1.1rem; margin-bottom:6px;">Заявка на вступление</h2>
    <form class="stack" method="POST" action="/join">
      <div class="field">
        <label>Твой ник</label>
        <input type="text" name="nickname" required>
      </div>
      <div class="field">
        <label>Контакт для связи (телеграм)</label>
        <input type="text" name="contact" placeholder="@username" required>
      </div>
      <div class="field">
        <label>Расскажи о себе (стаж, активность, почему хочешь в семью)</label>
        <textarea name="message" maxlength="800" placeholder="Например: играю 2 года, ранг 4 звезды, активность 1200..."></textarea>
      </div>
      <button class="btn btn-fun" type="submit">✨ Отправить заявку</button>
    </form>
  </div>

  <div class="card" style="margin-top:20px; text-align:center;">
    <p style="color:var(--muted); font-size:.9rem; margin:0;">Первый раз на сайте? Загляни в <a href="/guide">гайд для новичков</a> или <a href="/faq">FAQ</a>.</p>
  </div>
</div>

<%- include('partials/footer') %>
