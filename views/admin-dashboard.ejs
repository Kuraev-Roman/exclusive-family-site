<%- include('partials/header') %>

<div class="wrap">
  <div class="eyebrow">⚙️ Панель управления</div>
  <h1 class="gradient-text" style="font-size:2.1rem;">Админ-панель семьи</h1>
  <% if (!isFullAdmin) { %>
    <p style="color:var(--muted);">Ты вошёл как зам. администратора — доступны разделы контента, аккаунты и настройки видит только главный админ.</p>
  <% } %>

  <div class="grid grid-3" style="margin-top:24px;">
    <% if (isFullAdmin) { %>
    <a href="/admin/users" class="card">
      <div class="eyebrow">👤 Аккаунты</div>
      <h2 style="font-size:1.7rem;"><%= usersCount %></h2>
      <p style="color:var(--muted);">Создание и управление аккаунтами участников</p>
    </a>
    <% } %>
    <a href="/admin/birthdays" class="card">
      <div class="eyebrow">🎂 Дни рождения</div>
      <h2 style="font-size:1.7rem;"><%= birthdaysCount %></h2>
      <p style="color:var(--muted);">Ручное добавление, фото + импорт Excel/CSV</p>
    </a>
    <a href="/kraj" class="card">
      <div class="eyebrow">🚨 Кражи · новые</div>
      <h2 style="font-size:1.7rem;"><%= krajNewCount %></h2>
      <p style="color:var(--muted);">Непросмотренные сообщения от участников</p>
    </a>
    <a href="/admin/news" class="card">
      <div class="eyebrow">📰 Новости</div>
      <h2 style="font-size:1.7rem;"><%= newsCount %></h2>
      <p style="color:var(--muted);">Посты из телеграм-канала: текст, фото, видео</p>
    </a>
    <a href="/admin/interactives" class="card">
      <div class="eyebrow">🗳️ Интерактивы</div>
      <h2 style="font-size:1.7rem;"><%= pollsCount %></h2>
      <p style="color:var(--muted);">Голосования для участников семьи</p>
    </a>
    <a href="/admin/applications" class="card">
      <div class="eyebrow">✨ Заявки · новые</div>
      <h2 style="font-size:1.7rem;"><%= applicationsNewCount %></h2>
      <p style="color:var(--muted);">Заявки на вступление в семью</p>
    </a>
    <a href="/admin/album" class="card">
      <div class="eyebrow">📸 Альбом</div>
      <h2 style="font-size:1.7rem;"><%= albumCount %></h2>
      <p style="color:var(--muted);">Фото и видео семьи</p>
    </a>
    <a href="/admin/faq" class="card">
      <div class="eyebrow">❓ FAQ</div>
      <h2 style="font-size:1.7rem;"><%= faqCount %></h2>
      <p style="color:var(--muted);">Частые вопросы новичков</p>
    </a>
    <% if (isFullAdmin) { %>
    <a href="/admin/settings" class="card">
      <div class="eyebrow">🔗 Настройки</div>
      <h2 style="font-size:1.7rem;">⚙️</h2>
      <p style="color:var(--muted);">Соцсети, условия вступления, гайд, контакты админов</p>
    </a>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
